  {
  "name": "mormanski/fpl-lib",
  "type": "library",
  "description": "PHP Library to access the undocumented https://fantasy.premierleague.com API ",
  "keywords": [
    "PHP",
    "library",
    "api",
    "Premier league",
    "epl",
    "fantasy football"
  ],
  "homepage": "https://github.com/mormanski/fpl-lib",
  "license": "GPL-3.0",
  "prefer-stable": true,
  "minimum-stability": "dev",
  "authors": [
    {
      "name": "Darren Morman",
      "homepage": "https://github.com/mormanski"
    }
  ],
  "require": {
    "php": ">=7.2.5",
    "symfony/http-client": "^5.4 || ^6.0 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0",
    "symfony/polyfill-mbstring": "^1.20"
  },
  "autoload": {
    "psr-4": {
      "Mormanski\\FplLib\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mormanski\\FplLib\\Tests\\": "tests/"
    }
  }
}
